{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "prisma/seed.ts"],
  "exclude": ["src/**/*.test.ts"]
}
