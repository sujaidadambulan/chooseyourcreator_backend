PORT=4000
# Comma-separated allowed frontend origins for CORS and redirects
CLIENT_ORIGIN=http://localhost:5173
# Optional: public URL of the backend API for OAuth callbacks (defaults to CLIENT_ORIGIN or http://localhost:4000)
API_ORIGIN=http://localhost:4000
# Required in production — use a long random string (OAuth state signing)
JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/drcollab
# Prisma migrate uses DIRECT_DATABASE_URL. Supabase on Render: Session pooler :5432 on *.pooler.supabase.com — NOT db.*.supabase.co
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/drcollab
#
# --- Render production (set in Render dashboard, not in git) ---
# NODE_ENV=production
# DATABASE_URL=<Supabase Session pooler :5432 — can match DIRECT_DATABASE_URL>
# DIRECT_DATABASE_URL=<Supabase Session pooler :5432>
# API_ORIGIN=https://api.chooseyourcreator.in
# CLIENT_ORIGIN=https://www.chooseyourcreator.in
# GOOGLE_REDIRECT_URI=https://api.chooseyourcreator.in/api/auth/google/callback
# Test database (Vitest global setup)
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/drcollab_test
# Dev only: allow prisma db push outside local embedded Postgres (never in production)
# ALLOW_DB_PUSH=true
PAYMENTS_LIVE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=admin@chooseyourcreator.in
EMAIL_FROM_NAME=ChooseYourCreator
SMTP_FROM=ChooseYourCreator <admin@chooseyourcreator.in>
